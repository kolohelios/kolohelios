# Copy to `.env` (gitignored) and run commands via:
#   op run --env-file=.env -- wrangler deploy
#
# These resolve through 1Password at runtime; CI uses the same
# `.env.example` via the SA token — see `.github/workflows/cf-deploy.yml`.
# This Worker has no runtime secrets (it is fully public, no login), so
# only the Cloudflare deploy credentials live here.

# Cloudflare API token. Needs Workers Scripts:Edit (account-scoped) +
# Zone:DNS:Edit + Zone:Cache Settings:Edit for kolohelios.com. Provisioned
# by `infra/cloudflare-tokens` (tokens/deploy.cue is the source of truth).
CLOUDFLARE_API_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/Cloudflare Deploy Token/password"

# CF account ID. Stable and not secret; copy from the dashboard URL
# (`dash.cloudflare.com/<id>/...`). Passed literally because the
# deploy-scoped token can't list accounts via /accounts.
CLOUDFLARE_ACCOUNT_ID="cc625b188f1219ec7ff2e9d19d1a1a7e"
