{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(gh label list *)",
      "Bash(jj log *)",
      "Bash(jj bookmark *)",
      "Bash(cue vet *)",
      "Bash(jj diff *)",
      "Bash(cue export *)",
      "Bash(nix build *)",
      "Bash(jj st *)",
      "Bash(jj op log *)",
      "Bash(shaka *)",
      "Bash(tools/shaka/bin/shaka *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tools/shaka/bin/shaka claude hook pre-issue-create"
          }
        ]
      }
    ]
  }
}
