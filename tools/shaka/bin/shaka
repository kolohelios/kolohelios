#!/usr/bin/env bash
# Invoke the shaka CLI, rebuilding incrementally if any source has changed.
#
# Always re-enters the shaka dev shell unless we're already in it. Without
# this, shaka inherits the caller's PATH — which on systems with cargo
# installed via nix-darwin (or similar) might lack cue, jj, git, etc., and
# shaka would crash at runtime when it tries to spawn them. The marker env
# var IN_SHAKA_DEVSHELL is set on re-exec so we don't infinitely recurse.
#
# Cwd is preserved so commands that discover projects relative to cwd
# (`shaka project schema-check`, `shaka preflight`) work from the repo root.

set -euo pipefail

shaka_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${IN_SHAKA_DEVSHELL:-}" != "1" ]]; then
    exec env IN_SHAKA_DEVSHELL=1 nix develop "$shaka_dir" \
        --command bash "${BASH_SOURCE[0]}" "$@"
fi

cargo build --quiet --manifest-path "$shaka_dir/Cargo.toml"
exec "$shaka_dir/target/debug/shaka" "$@"
