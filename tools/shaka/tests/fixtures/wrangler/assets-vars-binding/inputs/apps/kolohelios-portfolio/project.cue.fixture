package project

// The kolohelios-portfolio shape: Workers Static Assets plus non-secret
// vars, a declared secret, and a `ratelimit` [[unsafe.bindings]] entry.
// Exercises the binding round-trip #819 adds.
#Project & {
	name: "kolohelios-portfolio"
	kind: "rust-worker"
	wrangler: {
		main:               "build/worker/shim.mjs"
		compatibility_date: "2026-05-01"
		assets: {
			directory: "./dist"
		}
		vars: {
			KIT_FORM_ID_CONTACT:    "9525720"
			KIT_FORM_ID_NEWSLETTER: "9525721"
		}
		secrets: ["KIT_API_KEY"]
		unsafe_bindings: [
			{
				name:         "SUBSCRIBE_RATE_LIMITER"
				type:         "ratelimit"
				namespace_id: "1001"
				simple: {
					limit:  5
					period: 60
				}
			},
		]
	}
}
