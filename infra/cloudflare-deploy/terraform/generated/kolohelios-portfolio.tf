resource "cloudflare_workers_custom_domain" "kolohelios_portfolio" {
  account_id = var.cloudflare_account_id
  zone_id    = data.cloudflare_zone.kolohelios_com.zone_id
  hostname   = "kolohelios.com"
  service    = "kolohelios-portfolio"
}

resource "cloudflare_ruleset" "kolohelios_portfolio_cache" {
  zone_id     = data.cloudflare_zone.kolohelios_com.zone_id
  name        = "kolohelios-portfolio cache rules"
  description = "Cache rules generated by shaka deploy generate-tf for kolohelios-portfolio"
  kind        = "zone"
  phase       = "http_request_cache_settings"

  rules = [
    {
      description = "Bypass cache for mutating methods and configured paths"
      expression  = "(http.request.method in {\"POST\" \"PUT\" \"DELETE\" \"PATCH\"} or starts_with(http.request.uri.path, \"/api/\"))"
      action      = "set_cache_settings"
      action_parameters = {
        cache = false
      }
    },
    {
      description = "Cache fingerprinted static assets long"
      expression  = "(ends_with(lower(http.request.uri.path), \".js\") or ends_with(lower(http.request.uri.path), \".css\") or ends_with(lower(http.request.uri.path), \".wasm\") or ends_with(lower(http.request.uri.path), \".woff2\") or ends_with(lower(http.request.uri.path), \".png\") or ends_with(lower(http.request.uri.path), \".jpg\") or ends_with(lower(http.request.uri.path), \".jpeg\") or ends_with(lower(http.request.uri.path), \".svg\") or ends_with(lower(http.request.uri.path), \".webp\") or ends_with(lower(http.request.uri.path), \".avif\"))"
      action      = "set_cache_settings"
      action_parameters = {
        cache = true
        edge_ttl = {
          mode    = "override_origin"
          default = 31536000
        }
        browser_ttl = {
          mode    = "override_origin"
          default = 31536000
        }
      }
    },
    {
      description = "Cache HTML (catch-all) at the edge for 3600s"
      expression  = "true"
      action      = "set_cache_settings"
      action_parameters = {
        cache = true
        edge_ttl = {
          mode    = "override_origin"
          default = 3600
        }
      }
    },
  ]
}
