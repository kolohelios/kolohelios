# Copy to `.env` (gitignored) and run commands via:
#   op run --env-file=.env -- just plan
#   op run --env-file=.env -- just deploy
#
# All secrets live in 1Password; `op run` resolves references at
# runtime.

# Cloudflare Pages-management token. Provisioned by
# `infra/cloudflare-tokens` (see that project's README for bootstrap and
# rotation). Permission: Account:Cloudflare Pages:Edit, scoped to the
# kolohelios account. Used by both the `tofu apply` (creates the Pages
# project) and the `wrangler pages deploy` step that uploads `site/`.
CLOUDFLARE_API_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/Cloudflare Pages Management Token/password"

# CF account ID. Stable and not secret; copy from the dashboard URL
# (`dash.cloudflare.com/<id>/...`). Same value the sibling `cloudflare-*`
# projects use.
TF_VAR_cloudflare_account_id="cc625b188f1219ec7ff2e9d19d1a1a7e"

# Wrangler reads `CLOUDFLARE_ACCOUNT_ID` (no `TF_VAR_` prefix) to skip
# the user-membership lookup the Pages-Edit token can't perform.
CLOUDFLARE_ACCOUNT_ID="cc625b188f1219ec7ff2e9d19d1a1a7e"

# S3-compatible credentials for the Linode Object Storage bucket that
# holds remote `tofu` state — minted by `shaka object-store init`.
AWS_ACCESS_KEY_ID="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/username"
AWS_SECRET_ACCESS_KEY="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/password"
