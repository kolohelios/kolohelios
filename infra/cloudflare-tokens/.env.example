# Copy to `.env` (gitignored) and run commands via:
#   op run --env-file=.env -- just plan
#
# All values are 1Password secret references; `op run` resolves them
# at runtime against your unlocked CLI session and exec's the command
# with the resolved values exported.

# Bootstrap meta-token: hand-minted in the CF dashboard with permission
# `User:API Tokens:Edit` only. Used by the CF provider to manage every
# other CF API token declared in this project. See README.md.
CLOUDFLARE_API_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/Cloudflare Meta Token/credential"

# CF account name — resolved to an account ID inside TF via the
# `cloudflare_accounts` data source.
TF_VAR_cloudflare_account_name="op://vedq2v6cmtkglnonkenrjneepa/Cloudflare Account/name"

# 1Password vault UUID where provisioned token values are written.
# This is the canonical "Kolohelios Monorepo" vault.
TF_VAR_onepassword_vault_id="vedq2v6cmtkglnonkenrjneepa"

# 1Password Service Account token — read-write scoped to the Kolohelios
# Monorepo vault. The TF `onepassword` provider reads this from the
# environment automatically.
OP_SERVICE_ACCOUNT_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/1Password Service Account/token"

# S3-compatible credentials for the Linode Object Storage bucket that
# holds remote `tofu` state — minted by `shaka object-store init`.
AWS_ACCESS_KEY_ID="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/access_key"
AWS_SECRET_ACCESS_KEY="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/secret_key"
