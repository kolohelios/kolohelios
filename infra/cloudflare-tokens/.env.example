# Copy to `.env` (gitignored) and run commands via:
#   op run --env-file=.env -- just plan
#
# Most values are 1Password secret references; `op run` resolves them at
# runtime against your unlocked CLI session and exec's the command with
# the resolved values exported.

# Bootstrap meta-token: hand-minted in the CF dashboard with permission
# `User:API Tokens:Edit` only. Used by the CF provider to manage every
# other CF API token declared in this project. Stored as a 1Password
# Password item with the token value in the `password` field.
CLOUDFLARE_API_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/Cloudflare Meta Token/password"

# CF account name. Not a secret; literal value or 1Password reference,
# either works. The TF `cloudflare_accounts` data source resolves this
# to an account ID at plan time.
TF_VAR_cloudflare_account_name="kolohelios"

# 1Password vault UUID where provisioned token values land. This is the
# canonical "Kolohelios Monorepo" vault.
TF_VAR_onepassword_vault_id="vedq2v6cmtkglnonkenrjneepa"

# 1Password Service Account token, read-write scoped to the Kolohelios
# Monorepo vault. Stored as a 1Password Password item with the SA token
# in the `password` field. The TF `onepassword` provider reads this
# from the environment automatically.
OP_SERVICE_ACCOUNT_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/1Password Service Account/password"

# S3-compatible credentials for the Linode Object Storage bucket that
# holds remote `tofu` state — minted by `shaka object-store init` and
# stored in 1Password alongside the other infra projects' references.
AWS_ACCESS_KEY_ID="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/username"
AWS_SECRET_ACCESS_KEY="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/password"
