# Copy to `.env` (gitignored) and run commands via:
#   op run --env-file=.env -- just plan
#
# All secrets live in 1Password; `op run` resolves references at
# runtime.

# Better Stack (Better Uptime) API token. Unlike the Cloudflare tokens
# (which are themselves Terraform-managed by infra/cloudflare-tokens),
# the monitoring vendor's own token is minted by hand in the Better
# Stack dashboard during bootstrap (see README.md) and stored in
# 1Password. The betteruptime Terraform provider auto-detects
# BETTERUPTIME_API_TOKEN from the environment.
BETTERUPTIME_API_TOKEN="op://vedq2v6cmtkglnonkenrjneepa/Better Stack Uptime API Token/password"

# S3-compatible credentials for the Linode Object Storage bucket that
# holds remote `tofu` state — minted by `shaka object-store init`.
AWS_ACCESS_KEY_ID="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/username"
AWS_SECRET_ACCESS_KEY="op://vedq2v6cmtkglnonkenrjneepa/Linode Object Storage TFSTATE/password"
